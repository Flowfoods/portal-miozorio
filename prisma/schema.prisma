// Esquema do portal Mi Ozorio (M1.1).
// Base: booking-engine/references/schema-sql.md, adaptado ao negócio da Milene
// (preço estúdio/domicílio, pending_price de sobrancelha, curso com turmas,
// campos de responsável/LGPD para debutantes menores — R6).
//
// ⚠️ A constraint no_overlap (EXCLUDE USING gist) que impede double-booking no
// banco (R2) NÃO é expressável em Prisma — está na migration SQL manual
// (prisma/migrations/.../migration.sql).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled_by_client
  cancelled_by_business
  no_show
}

/// Etapas do funil de noiva/debutante (CRM). Nunca agendável online (R14) —
/// avanço manual pela Mi no kanban do CRM, cada etapa com follow-up de jornada.
enum FunilEtapa {
  lead
  previa_agendada
  previa_feita
  contrato_fechado
  evento
  pos_evento
}

// ─────────────────────────── Financeiro ───────────────────────────
// Centro de custos + receita (booking + manual) + DRE mensal. Valores SEMPRE
// em centavos (Int). Datas: competência (mês a que o lançamento pertence) em
// @db.Date; caixa (paidAt/receivedAt) em Timestamptz. Soft-delete (active).

/// Natureza de uma categoria financeira.
enum FinancialKind {
  expense
  revenue
}

/// Fixo x variável (só para despesa) — alimenta o donut "fixo vs variável" e o CMV.
enum CostNature {
  fixed
  variable
}

/// Linha do DRE a que a categoria de DESPESA pertence (ordem da seção 2.5):
/// deducao_venda (taxa de cartão, DAS/impostos) → custo_variavel → custo_fixo → pro_labore.
enum DreGroup {
  deducao_venda
  custo_variavel
  custo_fixo
  pro_labore
}

/// Origem de um lançamento de receita.
enum RevenueSource {
  booking
  manual
}

/// Configuração do negócio — parâmetros externos, nunca hardcode (R3).
/// Chaves: working_hours, buffer_min, min_lead_hours, max_lead_days,
/// reminder_hours, cancel_window_days, strike_limit, hold_minutes,
/// timezone, deposit_policy.
model BusinessSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("business_settings")
}

model Professional {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name   String
  active Boolean @default(true)

  bookings       Booking[]
  scheduleBlocks ScheduleBlock[]

  @@map("professionals")
}

model Service {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String   @unique // slug estável p/ seed: maquiagem-social, penteado...
  name            String
  category        String // social | noiva | debutante | curso | sobrancelha
  durationMin     Int      @map("duration_min")
  bufferMin       Int      @default(15) @map("buffer_min")
  priceCents      Int      @map("price_cents") // preço estúdio/base
  priceHomeCents  Int?     @map("price_home_cents") // preço domicílio (null = n/a)
  bookableOnline  Boolean  @default(true) @map("bookable_online") // false p/ noiva/debutante (R1)
  requiresDeposit Boolean  @default(false) @map("requires_deposit")
  pendingPrice    Boolean  @default(false) @map("pending_price") // sobrancelha a confirmar
  isCourse        Boolean  @default(false) @map("is_course") // usa event_sessions
  clubPoints      Int      @default(0) @map("club_points") // pontos do Clube por atendimento (configurável pela Mi)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  bookings      Booking[]
  eventSessions EventSession[]
  waitlist      Waitlist[]
  availability  ServiceAvailability[]
  bookingItems  BookingItem[]

  @@map("services")
}

/// M9 — disponibilidade própria de um serviço (linha Dia a Dia: cabelo/sobrancelha
/// rodam em dias/horas diferentes da agenda social de fim de semana). Sem linhas
/// para um serviço = ele usa o working_hours global (retrocompatível).
model ServiceAvailability {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  weekday   Int // 1=seg … 7=dom (igual ao weekday do Luxon)
  startTime String @map("start_time") // "09:00"
  endTime   String @map("end_time") // "18:00"

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_availability")
}

model Customer {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  phoneE164        String      @unique @map("phone_e164") // +5521970225231 (R5)
  email            String?
  birthDate        DateTime?   @map("birth_date") @db.Date
  guardianName     String?     @map("guardian_name") // obrigatório se menor (R6)
  guardianPhone    String?     @map("guardian_phone")
  strikes          Int         @default(0)
  requiresDeposit  Boolean     @default(false) @map("requires_deposit") // régua de reincidência
  lgpdConsentAt    DateTime?   @map("lgpd_consent_at") @db.Timestamptz
  allergies        String? // alergia persistente da cliente — dado de saúde (R6/R18)
  notes            String? // anotações privadas da Mi — nunca aparecem no site
  photoConsent     Boolean     @default(false) @map("photo_consent") // foto da cliente só com isto (R18)
  photoConsentAt   DateTime?   @map("photo_consent_at") @db.Timestamptz // quando o consentimento mudou
  // Clube de Fidelidade — extensão do cliente (não há tabela de "membro";
  // ocasiões = bookings completed). club_joined_at null = não entrou no clube.
  referralCode     String?     @unique @map("referral_code") // link /indicar/<code>
  referredById     String?     @map("referred_by_id") @db.Uuid
  clubJoinedAt     DateTime?   @map("club_joined_at") @db.Timestamptz
  clubInterest     String?     @map("club_interest") // ocasião desejada/referência da indicada
  // Portal do cliente (auth própria). hash null + provisoria=true ⇒ senha = telefone.
  clubPasswordHash       String?   @map("club_password_hash")
  clubPasswordProvisoria Boolean   @default(true) @map("club_password_provisoria")
  clubFailedLogins       Int       @default(0) @map("club_failed_logins") // anti brute-force
  clubLockedUntil        DateTime? @map("club_locked_until") @db.Timestamptz
  clubConsentAt          DateTime? @map("club_consent_at") @db.Timestamptz // LGPD (1º acesso)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  // ── CRM (estende a ficha; observações privadas seguem em `notes`) ──
  tags             String[]    @default([]) // etiquetas livres da Mi (≠ MediaAsset.tags)
  origem           String? // captação (instagram, indicação...) p/ cadastro manual; quando há booking, deriva do source
  whatsappOptIn    Boolean     @default(false) @map("whatsapp_opt_in") // opt-in p/ jornadas de relacionamento (R3/LGPD)
  whatsappOptInAt  DateTime?   @map("whatsapp_opt_in_at") @db.Timestamptz
  // Opt-out de MARKETING (Campanhas F1). Default true p/ a base atual; "SAIR"/
  // "PARAR" no WhatsApp seta false. Só bloqueia envios tipo=CAMPANHA.
  aceitaMarketing  Boolean     @default(true) @map("aceita_marketing")
  aceitaMarketingEm DateTime?  @map("aceita_marketing_em") @db.Timestamptz
  funilEtapa       FunilEtapa? @map("funil_etapa") // só noiva/debutante (fora da matriz RFV)
  funilEtapaDesde  DateTime?   @map("funil_etapa_desde") @db.Timestamptz // F5: entrou na etapa atual em
  funilValorCents  Int?        @map("funil_valor_cents") // F5: valor estimado do contrato (pipeline)
  // ── RFV — calculados pelo job diário (src/lib/rfv.ts); null = ainda não calculado ──
  rScore           Int?        @map("r_score") // 1–5 (recência)
  fScore           Int?        @map("f_score") // 1–5 (frequência)
  vScore           Int?        @map("v_score") // 1–5 (valor)
  rfvSegmento      String?     @map("rfv_segmento") // "Campeãs" | "Fiéis" | "Promissoras" | "Em risco" | "Hibernando"
  ltvPrevistoCents Int?        @map("ltv_previsto_cents") // LTV projetado em centavos
  rfvCalculadoEm   DateTime?   @map("rfv_calculado_em") @db.Timestamptz

  bookings    Booking[]
  waitlist    Waitlist[]
  referredBy  Customer?           @relation("Indicacoes", fields: [referredById], references: [id])
  referrals   Customer[]          @relation("Indicacoes")
  milestones   ReferralMilestone[]
  redemptions  ClubRedemption[]
  clubTxns     ClubTransaction[]
  clubVouchers ClubVoucher[]
  envios       EnvioMensagem[]
  testimonials Testimonial[]
  events       ClientEvent[]
  funilEventos FunilEvento[]

  @@index([referredById])
  @@index([rfvSegmento])
  @@index([createdAt]) // novas clientes no período (F4)
  @@map("customers")
}

/// Marcos da escada de indicação: nasce quando a N-ésima indicada realiza um
/// atendimento (booking completed). UNIQUE (customer, nivel) = idempotente (R10).
model ReferralMilestone {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  nivel       Int // 1, 3, 5 indicações que fecharam
  beneficio   String // snapshot do texto do benefício na hora do marco
  liberadoEm  DateTime  @default(now()) @map("liberado_em") @db.Timestamptz
  resgatadoEm DateTime? @map("resgatado_em") @db.Timestamptz // Mi marca quando entrega

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, nivel])
  @@map("referral_milestones")
}

/// Brindes entregues fora da escada (aniversário, cortesias) — registro manual.
model ClubRedemption {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  beneficio   String
  origem      String   @default("manual") // manual | aniversario | ...
  resgatadoEm DateTime @default(now()) @map("resgatado_em") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("club_redemptions")
}

/// Clube por PONTOS (Anexo 1). Catálogo de recompensas configurável pela Mi:
/// prêmio (brinde) ou serviço, cada um com custo em pontos.
model ClubReward {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome        String
  tipo        String   @default("premio") // premio | servico
  custoPontos Int      @map("custo_pontos")
  ativo       Boolean  @default(true)
  sort        Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  vouchers ClubVoucher[]

  @@map("club_rewards")
}

/// Voucher de resgate self-service (fulfillment). O débito de pontos é o
/// ClubTransaction (tipo redemption); aqui mora o código + status que a Mi
/// marca como entregue. Snapshots de nome/custo p/ histórico estável.
model ClubVoucher {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  rewardId    String?   @map("reward_id") @db.Uuid
  rewardNome  String    @map("reward_nome")
  custoPontos Int       @map("custo_pontos")
  codigo      String    @unique // código curto p/ retirada
  status      String    @default("solicitado") // solicitado | entregue | cancelado
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  entregueAt  DateTime? @map("entregue_at") @db.Timestamptz

  customer Customer    @relation(fields: [customerId], references: [id])
  reward   ClubReward? @relation(fields: [rewardId], references: [id])

  @@index([customerId])
  @@index([status])
  @@map("club_vouchers")
}

/// Extrato auditável de pontos. Saldo = SUM(pontos). pontos > 0 ganha,
/// pontos < 0 resgata. dedup_key único garante crédito idempotente (R10)
/// — service:<bookingId>, indicacao_pct:<bookingId>, estorno_*:<bookingId>.
/// Legado: referral:<indicadaId> (pontuação fixa antiga, só leitura).
/// `meta` guarda o snapshot do lançamento (percentual/base/bookingId/indicadaId).
model ClubTransaction {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  pontos     Int
  tipo       String // service | referral | indicacao_percentual | redemption | manual | depoimento | foto | reagendamento
  descricao  String
  dedupKey   String?  @unique @map("dedup_key")
  meta       Json? // snapshot auditável do crédito de indicação/estorno
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([createdAt]) // extrato/totais por período (F4)
  @@map("club_transactions")
}

model Booking {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  serviceId      String        @map("service_id") @db.Uuid
  professionalId String?       @map("professional_id") @db.Uuid
  eventSessionId String?       @map("event_session_id") @db.Uuid
  startsAt       DateTime      @map("starts_at") @db.Timestamptz
  endsAt         DateTime      @map("ends_at") @db.Timestamptz // inclui buffer
  status         BookingStatus @default(pending)
  location       String        @default("studio") // studio | home
  priceCents     Int           @map("price_cents") // snapshot do valor cobrado
  holdExpiresAt  DateTime?     @map("hold_expires_at") @db.Timestamptz // só em pending
  depositCents   Int?          @map("deposit_cents")
  depositPaidAt  DateTime?     @map("deposit_paid_at") @db.Timestamptz
  anamnesis      Json? // respostas da anamnese (alergia = dado sensível, R6)
  source         String        @default("web") // web | whatsapp | manual
  // Foto de referência da cliente (LGPD): chave em storage PRIVADO (nunca URL
  // pública); servida só via /admin/media. Consentimento explícito obrigatório.
  photoKey       String?       @map("photo_key")
  photoConsentAt DateTime?     @map("photo_consent_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  customer      Customer          @relation(fields: [customerId], references: [id])
  service       Service           @relation(fields: [serviceId], references: [id])
  professional  Professional?     @relation(fields: [professionalId], references: [id])
  eventSession  EventSession?     @relation(fields: [eventSessionId], references: [id])
  events        BookingEvent[]
  notifications NotificationLog[]
  items         BookingItem[]
  revenueEntry  RevenueEntry? // receita reconhecida deste booking (1:1, idempotente)
  testimonials  Testimonial[] // depoimentos vinculados a este atendimento
  // ⚠️ CHECK (ends_at > starts_at) + constraint no_overlap EXCLUDE USING gist
  //    na migration SQL manual — ver migration.sql.

  @@index([startsAt])
  @@index([customerId])
  @@map("bookings")
}

/// Itens de um agendamento (multi-serviço). Um booking tem 1..N itens; cada um
/// guarda o snapshot da duração e do preço de tabela + o preço efetivamente
/// cobrado (editável por particularidade) e o motivo do ajuste. Base p/ BI.
/// booking.serviceId/priceCents seguem como "primário/total" (retrocompat).
model BookingItem {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId         String  @map("booking_id") @db.Uuid
  serviceId         String  @map("service_id") @db.Uuid
  durationMin       Int     @map("duration_min") // snapshot do catálogo
  priceTabelaCents  Int     @map("price_tabela_cents") // snapshot do catálogo
  priceCobradoCents Int     @map("price_cobrado_cents") // valor final cobrado
  motivoAjuste      String? @map("motivo_ajuste") // ex.: "cabelo longo", "desconto"
  sort              Int     @default(0)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@index([bookingId])
  @@map("booking_items")
}

/// Bloqueios de agenda (férias, evento fechado, compromisso). professional_id
/// NULL = bloqueia todos.
model ScheduleBlock {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  professionalId String?  @map("professional_id") @db.Uuid
  startsAt       DateTime @map("starts_at") @db.Timestamptz
  endsAt         DateTime @map("ends_at") @db.Timestamptz
  reason         String?

  professional Professional? @relation(fields: [professionalId], references: [id])

  @@map("schedule_blocks")
}

/// Auditoria de transições de status (quem/quando/motivo) — regra de ouro 7.
model BookingEvent {
  id         BigInt         @id @default(autoincrement())
  bookingId  String         @map("booking_id") @db.Uuid
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  actor      String // customer | business | system
  reason     String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("booking_events")
}

/// Turmas/cursos com vagas (ex: automaquiagem). vagas = capacity − confirmados.
model EventSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz
  endsAt    DateTime @map("ends_at") @db.Timestamptz
  capacity  Int      @default(1)

  service  Service   @relation(fields: [serviceId], references: [id])
  bookings Booking[]

  @@map("event_sessions")
}

/// Fila de espera de um dia lotado (R: F6).
model Waitlist {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  serviceId   String    @map("service_id") @db.Uuid
  desiredDate DateTime  @map("desired_date") @db.Date
  notifiedAt  DateTime? @map("notified_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])

  @@map("waitlist")
}

/// Usuárias do painel /admin (M5). Senha = hash bcrypt; bootstrap via seed
/// com ADMIN_EMAIL/ADMIN_PASSWORD (segredos só no Dokploy — R9).
model AdminUser {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String    @unique
  name           String
  passwordHash   String    @map("password_hash")
  active         Boolean   @default(true)
  // M13.2 — bloqueio progressivo de login (anti brute-force, por conta).
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz
  // Auth F1.2 — invalidação de sessões: o JWT carrega esta versão; ao trocar a
  // senha o número sobe e todos os tokens antigos deixam de valer.
  tokenVersion   Int       @default(0) @map("token_version")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("admin_users")
}

/// M13.4 — token de redefinição de senha por e-mail. Guarda só o SHA-256 do
/// token (nunca o valor cru), expira e é de uso único. Não há FK forte: se a
/// conta sumir, o token vira inválido na checagem.
model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([adminUserId])
  @@map("password_reset_tokens")
}

/// Auth F2.2 — recuperação de senha da CLIENTE por código de 6 dígitos (WhatsApp).
/// Guarda só o SHA-256 do código (nunca o valor cru), expira em 10min, máx. 3
/// tentativas de digitação, uso único. last_sent_at controla o cooldown (60s) de
/// reenvio. Sem FK forte (mesmo padrão do reset do admin).
model ClubPasswordReset {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  attempts   Int       @default(0)
  usedAt     DateTime? @map("used_at") @db.Timestamptz
  lastSentAt DateTime  @default(now()) @map("last_sent_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([customerId])
  @@map("club_password_resets")
}

/// Auth F3 — Passkey (WebAuthn / Face ID / biometria). Serve os DOIS portais:
/// `area` (admin|cliente) + `subjectId` (adminUserId ou customerId). É SEMPRE
/// adicional — a senha continua como fallback. Guarda a chave pública (não há
/// segredo do lado do servidor); `counter` valida anti-clonagem.
model Passkey {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  area         String // admin | cliente
  subjectId    String    @map("subject_id") @db.Uuid
  credentialId String    @unique @map("credential_id") // base64url
  publicKey    String    @map("public_key") // base64url da COSE public key
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  deviceName   String    @map("device_name")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz

  @@index([area, subjectId])
  @@map("passkeys")
}

/// Auth F1.2 — auditoria de autenticação dos DOIS portais (admin e cliente).
/// NUNCA guarda senha/token/código, só metadados. O IP entra hasheado (SHA-256,
/// LGPD); o identificador da cliente entra mascarado (••••1234). Também serve de
/// base para o rate-limit por IP (contagem de falhas recentes por ip_hash).
model AuthLog {
  id         BigInt   @id @default(autoincrement())
  area       String // admin | cliente
  event      String // login_ok | login_fail | locked | reset_request | reset_done | recover_request | recover_ok ...
  identifier String? // e-mail (admin) ou telefone mascarado (cliente)
  ipHash     String?  @map("ip_hash")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([area, event, createdAt])
  @@index([ipHash, createdAt])
  @@map("auth_log")
}

/// Fotos do site (M8.4): hero, página Sobre, portfólio e cards de serviço.
/// Arquivo físico em MEDIA_DIR (volume persistente), servido por /media/...
model MediaAsset {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url       String   @unique // caminho público: /media/<arquivo>.webp
  alt       String
  category  String // portfolio | hero | sobre | servico
  tags      String[] @default([])
  sort      Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  // BUG D — original preservado + metadados de entrega (todas opcionais:
  // fotos antigas não têm; migration 100% aditiva — R11).
  origUrl   String?  @map("orig_url") // chave em orig/ (nunca servida)
  width     Int? // dimensões do master — proporção sem layout shift
  height    Int?
  blurData  String?  @map("blur_data") // data URL p/ placeholder="blur"

  @@index([category, published])
  @@map("media_assets")
}

/// M12 — depoimentos de clientes (prova social). CRUD pela Mi no /admin.
/// LGPD: só publicar com autorização da cliente (Anexo A).
/// F1 (Área da Cliente): estendido aditivamente — a cliente envia o próprio
/// depoimento (origem=cliente) com fotos e ele passa por moderação da Mi.
/// `published` legado = espelho de status='aprovado' (manter sincronizado).
model Testimonial {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quote     String // o depoimento
  author    String // "Ana · madrinha"
  published Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // ── Área da Cliente (F1) ──
  customerId             String?   @map("customer_id") @db.Uuid
  bookingId              String?   @map("booking_id") @db.Uuid // atendimento vinculado (opcional)
  rating                 Int? // 1–5 (validação no código)
  status                 String    @default("pendente") // rascunho | pendente | aprovado | rejeitado | arquivado
  motivoRejeicao         String?   @map("motivo_rejeicao")
  consentimentoPublicoAt DateTime? @map("consentimento_publico_at") @db.Timestamptz // LGPD: quando a cliente autorizou exibição
  destaque               Boolean   @default(false) // Mi fixa primeiro na vitrine
  origem                 String    @default("admin") // admin | cliente
  enviadoEm              DateTime? @map("enviado_em") @db.Timestamptz
  moderadoEm             DateTime? @map("moderado_em") @db.Timestamptz
  moderadoPor            String?   @map("moderado_por") // e-mail da admin que moderou

  customer Customer?          @relation(fields: [customerId], references: [id])
  booking  Booking?           @relation(fields: [bookingId], references: [id])
  photos   TestimonialPhoto[]

  @@index([published])
  @@index([customerId])
  @@index([status])
  @@map("testimonials")
}

/// Foto de um depoimento (Área da Cliente). Arquivo no store PRIVADO (priv/)
/// — nunca em /media público. Servida por rota com gate por status no banco
/// (só aparece se o depoimento está aprovado E a foto está aprovada).
model TestimonialPhoto {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  testimonialId String   @map("testimonial_id") @db.Uuid
  fileKey       String   @map("file_key") // chave no store privado (basename)
  ordem         Int      @default(0)
  aprovada      Boolean  @default(true) // Mi pode aprovar o texto e ocultar uma foto
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  testimonial Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@index([testimonialId])
  @@map("testimonial_photos")
}

/// CMS leve (Onda B): textos editáveis das páginas, por chave. Default no
/// código (registry em src/lib/content.ts); a linha aqui é só o override da Mi.
model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("site_content")
}

/// Vitrine editável de noiva/debutante (Onda B). categoria = noiva | debutante.
/// Preço/parcela são texto livre (vitrine, não agendável — R14). Sem linhas para
/// uma categoria, a página cai no fallback do código.
model Pacote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoria String
  nome      String
  preco     String
  parcela   String?
  itens     String[] @default([])
  rodape    String? // "Cortesia: ..." (noiva)
  destaque  Boolean  @default(false)
  sort      Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([categoria, ativo])
  @@map("pacotes")
}

/// Perguntas frequentes editáveis por categoria (noiva | debutante). Alimentam
/// a página e o JSON-LD FAQPage. Sem linhas → fallback do código.
model Faq {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoria String
  pergunta  String
  resposta  String
  sort      Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([categoria, ativo])
  @@map("faqs")
}

/// Idempotência de webhooks/notificações (R10). dedup_key único por evento.
model NotificationLog {
  id        BigInt   @id @default(autoincrement())
  bookingId String?  @map("booking_id") @db.Uuid
  kind      String // reminder_24h | confirmation | review_request...
  dedupKey  String   @unique @map("dedup_key")
  sentAt    DateTime @default(now()) @map("sent_at") @db.Timestamptz

  booking Booking? @relation(fields: [bookingId], references: [id])

  @@map("notification_log")
}

/// Outbox de WhatsApp (Campanhas F1) — porta ÚNICA de saída rastreável. Toda
/// mensagem vira uma linha aqui: idempotência por dedupeKey, retry com backoff,
/// status consultável no admin. tipo=CAMPANHA respeita opt-out (aceitaMarketing);
/// TRANSACIONAL (confirmação/lembrete/código) nunca é bloqueado por opt-out.
model WhatsAppMessage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId      String?   @map("cliente_id") @db.Uuid
  telefone       String // E.164 (só dígitos no envio)
  tipo           String // TRANSACIONAL | CAMPANHA
  templateKey    String?   @map("template_key")
  texto          String
  payload        Json?
  status         String    @default("QUEUED") // QUEUED|SENT|DELIVERED|FAILED|OPTED_OUT
  tentativas     Int       @default(0)
  proximaTentativa DateTime? @map("proxima_tentativa") @db.Timestamptz
  erro           String?
  campanhaId     String?   @map("campanha_id") @db.Uuid
  dedupeKey      String    @unique @map("dedupe_key")
  criadoEm       DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  enviadoEm      DateTime? @map("enviado_em") @db.Timestamptz

  @@index([status, proximaTentativa])
  @@index([tipo, status, criadoEm])
  @@index([clienteId])
  @@map("whatsapp_message")
}

/// Central de Campanhas (F2) — "o Repediu da Mi". PONTUAL (dispara 1×) ou
/// AUTOMATICA (gatilho recorrente). segmentoConfig = filtros combináveis (AND)
/// que LEEM o CRM/RFV existente (não duplicam lógica). janelaConversaoDias =
/// quantos dias após o envio um agendamento conta como conversão.
model Campanha {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                String
  tipo                String // PONTUAL | AUTOMATICA
  status              String    @default("RASCUNHO") // RASCUNHO|AGENDADA|ATIVA|PAUSADA|CONCLUIDA
  segmentoConfig      Json      @map("segmento_config")
  corpo               String // texto da mensagem (com variáveis {nome} etc.)
  agendadaPara        DateTime? @map("agendada_para") @db.Timestamptz
  recorrencia         String? // preset da automática: sentimos_falta|aniversario|recompra|pos_evento
  modoAprovacao       Boolean   @default(true) @map("modo_aprovacao")
  janelaConversaoDias Int       @default(7) @map("janela_conversao_dias")
  criadoEm            DateTime  @default(now()) @map("criado_em") @db.Timestamptz

  envios CampanhaEnvio[]

  @@index([tipo, status])
  @@map("campanha")
}

/// Biblioteca de textos prontos (F3 popula 8). Ponto de partida editável.
model CampanhaTemplate {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome     String
  corpo    String
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz

  @@map("campanha_template")
}

/// Um envio de campanha ↔ mensagem do outbox + conversão (agendou na janela).
model CampanhaEnvio {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campanhaId        String    @map("campanha_id") @db.Uuid
  clienteId         String    @map("cliente_id") @db.Uuid
  whatsappMessageId String?   @map("whatsapp_message_id") @db.Uuid
  convertidoEm      DateTime? @map("convertido_em") @db.Timestamptz
  receitaCents      Int?      @map("receita_cents")
  criadoEm          DateTime  @default(now()) @map("criado_em") @db.Timestamptz

  campanha Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

  @@unique([campanhaId, clienteId])
  @@index([campanhaId])
  @@map("campanha_envio")
}

/// CRM 2.0 F1 — eventos de comportamento first-party (sem libs de terceiros).
/// clientId null = visitante anônimo, amarrado por sessionId (cookie mi_sid, sem
/// PII); no login do Clube os eventos da sessão anônima são vinculados à cliente
/// (merge). `metadata` NUNCA guarda dado sensível (R18): sem alergia/anamnese/PII.
/// Excluído em cascata com a cliente (LGPD). Retenção configurável (job de limpeza).
model ClientEvent {
  id        BigInt   @id @default(autoincrement())
  clientId  String?  @map("client_id") @db.Uuid
  sessionId String   @map("session_id") // cookie mi_sid (anônimo)
  tipo      String // SESSAO_INICIADA | VISUALIZOU_AGENDAMENTO | AGENDAMENTO_CONCLUIDO | ...
  origem    String   @default("web") // web | whatsapp
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  client Customer? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, tipo, createdAt])
  @@index([tipo, createdAt])
  @@index([sessionId])
  @@map("client_events")
}

/// CRM 2.0 F5 — log de transições do funil de noiva (tempo médio por etapa).
/// Escrito a cada mudança de etapa (kanban ou ficha). Cascade com a cliente.
model FunilEvento {
  id         BigInt   @id @default(autoincrement())
  customerId String   @map("customer_id") @db.Uuid
  de         String?
  para       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("funil_eventos")
}

/// CRM 2.0 F2 — configuração da régua RFV editável pela Mi (R15: nada de faixa
/// hardcoded). VERSIONADA: cada salvamento é uma linha nova (nunca UPDATE) — a
/// linha mais recente é a vigente e a própria tabela é o histórico
/// (quem mudou, quando, de → para via diff entre versões consecutivas).
/// Shape do `config` validado por zod em src/lib/crm-config.ts.
model CrmConfig {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  config    Json
  criadoPor String?  @map("criado_por") // e-mail da conta do painel que salvou
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@map("crm_config")
}

// ─────────────────────────── CRM — Jornadas ───────────────────────────

/// Definição de uma jornada (fluxo automático por comportamento). gatilho =
/// boas_vindas | pos_atendimento | aniversario | manutencao | reativacao |
/// noiva | manual. Começa desligada (ativo=false) até a Mi revisar a copy.
model Jornada {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String
  gatilho   String
  ativo     Boolean  @default(false)
  descricao String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  etapas JornadaEtapa[]
  envios EnvioMensagem[]

  @@map("jornadas")
}

/// Passo de uma jornada: espera (h) após o gatilho/etapa anterior e a mensagem.
/// templateKey aponta p/ site_content (msg.*, editável pela Mi); template é o
/// texto inline de fallback. condicao = critério opcional de saída.
model JornadaEtapa {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jornadaId   String  @map("jornada_id") @db.Uuid
  ordem       Int
  esperaHoras Int     @default(0) @map("espera_horas")
  templateKey String? @map("template_key")
  template    String?
  condicao    String?

  jornada Jornada @relation(fields: [jornadaId], references: [id], onDelete: Cascade)

  @@index([jornadaId])
  @@map("jornada_etapas")
}

/// Auditoria de disparo de mensagem (jornadas/CRM). dedup_key único = R10.
/// status: pendente | enviado | falha | cancelado. Complementa notification_log
/// (que segue cuidando da dedupe do cron/eventos transacionais).
model EnvioMensagem {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  jornadaId  String?   @map("jornada_id") @db.Uuid
  etapaId    String?   @map("etapa_id") @db.Uuid
  canal      String    @default("whatsapp")
  kind       String
  // aguardando (fila de aprovação da Mi — F4) | pendente | enviado | falha | cancelado
  status     String    @default("pendente")
  // Texto FINAL da mensagem (F4): proposto pela régua, editável pela Mi na fila.
  texto      String?
  erro       String?
  dedupKey   String?   @unique @map("dedup_key")
  agendadoEm DateTime? @map("agendado_em") @db.Timestamptz
  enviadoEm  DateTime? @map("enviado_em") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jornada  Jornada? @relation(fields: [jornadaId], references: [id])

  @@index([customerId])
  @@index([status])
  @@map("envios_mensagem")
}

// ─────────────────────────── Financeiro (modelos) ───────────────────────────

/// Categoria de um lançamento financeiro (despesa ou receita). `nature` e
/// `dreGroup` só fazem sentido para despesa; `isCmv` marca insumo/descartável
/// (entra no CMV do mês). `color` (hex) pinta os gráficos. Seed traz as padrão.
model FinancialCategory {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String        @unique // slug estável p/ seed idempotente e mapeamento
  name      String
  kind      FinancialKind
  nature    CostNature? // só despesa
  dreGroup  DreGroup?     @map("dre_group") // só despesa — linha do DRE
  isCmv     Boolean       @default(false) @map("is_cmv") // insumo/descartável → CMV
  color     String        @default("#8A7361") // hex p/ gráfico
  isDefault Boolean       @default(false) @map("is_default")
  sort      Int           @default(0)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz

  expenses  Expense[]
  revenues  RevenueEntry[]
  recurring RecurringCost[]

  @@index([kind, active])
  @@map("financial_categories")
}

/// Despesa lançada pela Mi (insumo, aluguel, energia, tráfego, taxa, DAS…).
/// competenceDate = mês a que pertence; paidAt = quando saiu o dinheiro (caixa).
/// Soft-delete por `active` (nunca apaga histórico — R financeiro 4).
model Expense {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId     String    @map("category_id") @db.Uuid
  description    String
  amountCents    Int       @map("amount_cents")
  competenceDate DateTime  @map("competence_date") @db.Date
  paidAt         DateTime? @map("paid_at") @db.Timestamptz // caixa; null = a pagar
  paymentMethod  String?   @map("payment_method") // pix | cartao | dinheiro | boleto
  supplier       String?
  isRecurring    Boolean   @default(false) @map("is_recurring")
  recurringId    String?   @map("recurring_id") @db.Uuid // origem, se gerada por template
  notes          String?
  active         Boolean   @default(true) // soft-delete
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  category    FinancialCategory @relation(fields: [categoryId], references: [id])
  recurring   RecurringCost?    @relation(fields: [recurringId], references: [id])
  attachments Attachment[]

  @@index([competenceDate])
  @@index([categoryId])
  @@index([recurringId, competenceDate])
  @@map("expenses")
}

/// Receita: automática (BOOKING concluído, idempotente por bookingId) ou manual
/// (noiva/debutante/curso/venda avulsa). competenceDate = data do evento/serviço;
/// receivedAt = quando o dinheiro entrou (caixa). cardFeeCents = taxa de cartão
/// dessa entrada (dedução sobre venda). Soft-delete por `active`.
model RevenueEntry {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId     String?       @map("category_id") @db.Uuid
  description    String
  amountCents    Int           @map("amount_cents")
  competenceDate DateTime      @map("competence_date") @db.Date
  receivedAt     DateTime?     @map("received_at") @db.Timestamptz // caixa; null = a receber
  source         RevenueSource @default(manual)
  bookingId      String?       @unique @map("booking_id") @db.Uuid // idempotência (1:1)
  customerName   String?       @map("customer_name")
  paymentMethod  String?       @map("payment_method") // pix | cartao | dinheiro | boleto
  cardFeeCents   Int?          @map("card_fee_cents")
  active         Boolean       @default(true) // soft-delete
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  category    FinancialCategory? @relation(fields: [categoryId], references: [id])
  booking     Booking?           @relation(fields: [bookingId], references: [id])
  attachments Attachment[]

  @@index([competenceDate])
  @@index([categoryId])
  @@map("revenue_entries")
}

/// Comprovante/nota de um lançamento (PDF ou imagem). Arquivo no store PRIVADO
/// (MEDIA_DIR/priv) — só `filePath` (chave/nome), nunca caminho absoluto. Exatamente
/// um dos dois donos (expense XOR revenue) — CHECK na migration.
model Attachment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filePath   String   @map("file_path") // chave no store privado (basename)
  fileName   String   @map("file_name") // nome original (exibição/download)
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  expenseId  String?  @map("expense_id") @db.Uuid
  revenueId  String?  @map("revenue_id") @db.Uuid
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  expense Expense?      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  revenue RevenueEntry? @relation(fields: [revenueId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([revenueId])
  @@map("attachments")
}

/// Template de custo fixo recorrente. Gera uma Expense por mês (cron Fase 5),
/// idempotente por (recurringId, competenceDate=1º do mês). dayOfMonth = vencimento.
model RecurringCost {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  description   String
  amountCents   Int      @map("amount_cents")
  dayOfMonth    Int      @map("day_of_month") // 1–28 (vencimento)
  paymentMethod String?  @map("payment_method")
  supplier      String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  category FinancialCategory @relation(fields: [categoryId], references: [id])
  expenses Expense[]

  @@map("recurring_costs")
}
