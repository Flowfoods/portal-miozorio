# Portal Mi Ozorio — exemplo de variáveis de ambiente.
# Valores REAIS apenas no Dokploy / .env local (nunca no Git — regra R9).

# Banco de dados (container pg-miozorio, PostgreSQL 16, rede interna da VPS)
DATABASE_URL="postgresql://USER:PASSWORD@pg-miozorio:5432/miozorio?schema=public"

# Fuso horário (horários persistidos em UTC, exibidos em America/Sao_Paulo — R4)
TZ="America/Sao_Paulo"

# URLs públicas
NEXT_PUBLIC_SITE_URL="https://miozorio.com.br"

# NextAuth (painel admin /admin) — gerar: openssl rand -base64 32
NEXTAUTH_URL="https://miozorio.com.br"
NEXTAUTH_SECRET=""

# Bootstrap da conta do painel (seed cria só se o e-mail não existir)
ADMIN_EMAIL=""
ADMIN_NAME="Mi"
ADMIN_PASSWORD=""

# Resend — e-mail transacional (reset de senha do painel — M13.4).
# Criar chave em resend.com e verificar o domínio de envio (miozorio.com.br).
RESEND_API_KEY=""
EMAIL_FROM="Mi Ozorio <nao-responda@miozorio.com.br>"

# n8n — webhook que recebe eventos do app (Clube → WhatsApp via Evolution, M4).
# Sem isto, o app não emite nada (no-op). O token é checado pelo workflow n8n.
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_TOKEN=""

# Evolution API — instância evo-miozorio (reaproveita o container existente na VPS)
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="evo-miozorio"

# Cron diário dos lembretes por tempo (lembrete da véspera, aniversário, +1 ano,
# pós-atendimento, reconexão). O Dokploy Schedules chama POST /api/cron/lembretes
# 1×/dia com "Authorization: Bearer $CRON_SECRET". Sem esta env, o endpoint
# responde 401 (fail-closed). Gerar: openssl rand -base64 32
CRON_SECRET=""

# WhatsApp da Mi em E.164 (R5)
MI_WHATSAPP="+5521970225231"

# Pasta das fotos do site (M8.4). Em producao = /app/media (volume Dokploy);
# localmente pode omitir (default ./media)
MEDIA_DIR="/app/media"
EVOLUTION_WEBHOOK_TOKEN=""
WHATSAPP_MI="https://wa.me/5521970225231"

# ── Pagamento do sinal (A7) ────────────────────────────────────────────────
# VAZIO = sem cobrança pelo portal. Este é o estado normal até a Mi decidir o
# provedor: a reserva com sinal nasce guardada e a combinação acontece no
# WhatsApp dela. Nenhuma cliente vê um botão "Pagar" que não funciona.
#
# Para ligar o Mercado Pago (PIX):
#   PAGAMENTO_PROVIDER="mercadopago"
#   MP_ACCESS_TOKEN="APP_USR-..."      # credencial de PRODUÇÃO da conta da Mi
#   MP_WEBHOOK_SECRET="..."            # "Assinatura secreta" do painel de webhooks
# Sem MP_WEBHOOK_SECRET o webhook recusa TUDO (fail-closed) — webhook de
# pagamento sem verificação é um botão de "marcar como pago" aberto na internet.
# Webhook a cadastrar no Mercado Pago:
#   https://miozorio.com.br/api/webhooks/pagamento   (evento: payment)
PAGAMENTO_PROVIDER=""
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
